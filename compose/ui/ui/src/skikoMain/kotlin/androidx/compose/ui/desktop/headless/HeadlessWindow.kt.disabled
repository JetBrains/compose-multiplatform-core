private val nextWindowId = AtomicLong(0)

@OptIn(ExperimentalComposeUiApi::class)
class HeadlessWindow internal constructor(
    private val application: HeadlessApplication,
    devicePixelRatio: Float = 1.0f,
    internal var scene: Scene<*>? = null,
    focusRestorationCoroutineScope: CoroutineScope,
    internal var onCloseRequest: () -> Unit,
) : Window, LayoutOwner {
    var drawContent: (Canvas.() -> Unit)? = null

    override val id: LightweightWindowId = LightweightWindowId(nextWindowId.incrementAndFetch())

    override var title: String = "Headless Window"

    private var _size: DpSize by mutableStateOf(DpSize(800.dp, 600.dp))
    override val size: DpSize get() = _size
    override val contentSize: DpSize get() = _size

    override fun requestSize(size: DpSize) {
        _size = size
    }

    private var _minSize: DpSize by mutableStateOf(DpSize(0.dp, 0.dp))
    override val minSize: DpSize get() = _minSize
    override fun requestMinSize(minSize: DpSize) {
        _minSize = minSize
    }

    private var _maxSize: DpSize by mutableStateOf(DpSize(Float.MAX_VALUE.dp, Float.MAX_VALUE.dp))
    override val maxSize: DpSize get() = _maxSize
    override fun requestMaxSize(maxSize: DpSize) {
        _maxSize = maxSize
    }

    private var _isUserResizable by mutableStateOf(true)
    override val isUserResizable: Boolean get() = _isUserResizable
    override fun requestUserResizable(userResizable: Boolean) {
        _isUserResizable = userResizable
    }

    private val _screen = HeadlessScreen(devicePixelRatio = devicePixelRatio)
    override val screen: Screen get() = _screen

    override val density: Density = _screen.density

    private var _isFocused: Boolean by mutableStateOf(true)
    override val isFocused: Boolean get() = _isFocused


    override fun requestFocus() {
        _isFocused = true
    }

    override fun requestBringToFront() {
        // No-op for headless
    }

    override fun requestFocusAndBringToFront() {
        _isFocused = true
    }

    override var decoration: WindowDecoration by mutableStateOf(WindowDecoration.Decorated)
        private set

    override fun requestDecoration(vararg decorations: WindowDecoration) {
        decorations.firstOrNull()?.let { decoration = it }
    }

    override val customTitleBarInsets: Pair<Dp, Dp>? = null

    override val systemTheme: SystemTheme get() = SystemTheme.Light

    override fun requestSystemTheme(systemTheme: SystemTheme?) {
        // No-op for headless
    }

    override fun requestMinimized(minimized: Boolean) {}

    private var _placement: WindowPlacement by mutableStateOf(WindowPlacement.Floating)
    override val placement: WindowPlacement get() = _placement

    override fun requestPlacement(placement: WindowPlacement) {
        _placement = placement
    }

    override fun showOpenSingleDialog(
        title: String,
        prompt: String,
        message: String?,
        nameFieldStringValue: String?,
        directoryPath: Path?,
        canCreateDirectories: Boolean,
        canSelectHiddenExtensions: Boolean,
        showsHiddenFiles: Boolean,
        isExtensionHidden: Boolean,
        canChooseFiles: Boolean,
        canChooseDirectories: Boolean,
        resolvesAliases: Boolean,
    ): Path? = null

    override fun showOpenMultipleDialog(
        title: String,
        prompt: String,
        message: String?,
        nameFieldStringValue: String?,
        directoryPath: Path?,
        canCreateDirectories: Boolean,
        canSelectHiddenExtensions: Boolean,
        showsHiddenFiles: Boolean,
        isExtensionHidden: Boolean,
        canChooseFiles: Boolean,
        canChooseDirectories: Boolean,
        resolvesAliases: Boolean,
    ): List<Path> = emptyList()

    override fun showSaveDialog(
        title: String,
        prompt: String,
        message: String?,
        nameFieldLabel: String,
        nameFieldStringValue: String?,
        directoryPath: Path?,
        canCreateDirectories: Boolean,
        canSelectHiddenExtensions: Boolean,
        showsHiddenFiles: Boolean,
        isExtensionHidden: Boolean,
    ): Path? = null

    override fun captureScreenshot(): ImageBitmap {
        TODO()
    }

    override val nativeWindow: Any = Unit

    private var isDisposed = false

    override fun dispose() {
        if (!isDisposed) {
            isDisposed = true
            application.removeWindow(id)
        }
    }

    private val onPreviewKeyEventState = SnapshotMutableStateImpl<(KeyEvent) -> Boolean>({ false })
    private val onKeyEventState = SnapshotMutableStateImpl<(KeyEvent) -> Boolean>({ false })
    private var contentState = SnapshotMutableStateImpl<(@Composable WindowScope.() -> Unit)?>(null)

    private val focusOwner = FocusOwnerImpl(
        { focusRestorationCoroutineScope },
        DebugLocation(this::class),
    ) { isFocused }

    override fun setContent(
        onPreviewKeyEvent: (KeyEvent) -> Boolean,
        onKeyEvent: (KeyEvent) -> Boolean,
        noriaState: NoriaState?,
        content: @Composable WindowScope.() -> Unit,
    ) {
        onPreviewKeyEventState.setValueAndScheduleDependantsRightAway(noriaState, onPreviewKeyEvent)
        onKeyEventState.setValueAndScheduleDependantsRightAway(noriaState, onKeyEvent)
        contentState.setValueAndScheduleDependantsRightAway(noriaState, content)
    }

    internal var latestRootLayoutNode: LayoutNode? = null
        set(value) {
            field?.let {
                if (it.owner != null && value?.id != it.id) {
                    it.detach()
                }
            }
            if (value != null && value.owner != this) {
                value.attach(this)
            }
            field = value
        }

    private val latestLayoutNodes = mutableMapOf<Int, LayoutNode>()
    private val pointerInputEventProcessor =
        NoriaPointerInputEventProcessor { latestLayoutNodes[it.id] }

    private val positionCalculator = object : PositionCalculator {
        override fun screenToLocal(positionOnScreen: Offset): Offset {
            return positionOnScreen
        }

        override fun localToScreen(localPosition: Offset): Offset {
            return localPosition
        }

        override val rootPositionOnScreen: Offset = Offset.Zero
    }

    override fun onAttach(node: LayoutNode) {
        if (node.id.id != 0) {
            latestLayoutNodes[node.id.id] = node
        }
    }

    override fun get(id: ID): LayoutNode? = latestLayoutNodes[id.id]

    override fun onDetach(node: LayoutNode) {
        latestLayoutNodes.remove(node.id.id)
    }

    override fun calculatePositionInWindow(localPosition: Offset): Offset {
        return localPosition
    }

    override fun calculateLocalPosition(positionInWindow: Offset): Offset {
        return positionInWindow
    }

    private val viewConfiguration: ViewConfiguration = object : ViewConfiguration {
        override val longPressTimeoutMillis: Long = 500
        override val doubleTapTimeoutMillis: Long = 300
        override val doubleTapMinTimeMillis: Long = 40
        override val touchSlop: Float get() = density.run { 18.dp.toPx() }
    }

    private val windowInfo: WindowInfo = object : WindowInfo {
        override val isWindowFocused: Boolean get() = isFocused

        override fun requestWindowFocus() {
            requestFocus()
        }

        @OptIn(InternalComposeUiApi::class, ExperimentalComposeUiApi::class, InternalCoreApi::class)
        override val keyboardModifiers: PointerKeyboardModifiers
            get() = inputStateTracker.keyboardModifiers

        @ExperimentalComposeUiApi
        override val containerSize: IntSize
            get() = density.run {
                contentSize.run {
                    IntSize(width.roundToPx(), height.roundToPx())
                }
            }
    }

    @OptIn(ExperimentalComposeUiApi::class, InternalCoreApi::class)
    private val inputStateTracker = InputStateTracker(
        inputModeManager = application.inputModeManager,
        sendPointerInputEvent = { pointerInputEvent ->
            latestRootLayoutNode?.let { rootLayoutNode ->
                val process = {
                    pointerInputEventProcessor.process(
                        pointerInputEvent,
                        rootLayoutNode,
                        positionCalculator,
                    )
                }
                process()
            } ?: ProcessResult(0)
        },
        sendKeyEvent = { keyEvent ->
            val process = {
                onPreviewKeyEventState.value(keyEvent) ||
                    focusOwner.dispatchKeyEvent(keyEvent) ||
                    onKeyEventState.value(keyEvent)
            }
            process()
        },
    )

    @OptIn(InternalCoreApi::class)
    @Composable
    override fun Content(onLayout: (WindowData) -> Unit) {
        val dragAndDropOwner = remember {
            object : DragAndDropManager {
                override val modifier: Modifier = Modifier
                override val isRequestDragAndDropTransferRequired: Boolean = true

                override fun requestDragAndDropTransfer(
                    node: DragAndDropNode,
                    offset: Offset,
                ) {
                }

                override fun registerTargetInterest(target: DragAndDropTarget) {
                }

                override fun isInterestedTarget(target: DragAndDropTarget): Boolean {
                    return true
                }

                override fun onNodeAttached(node: DragAndDropNode) {
                }

                override fun onNodeDetached(node: DragAndDropNode) {
                }

            }
        }
        CompositionLocalProvider(
            LocalDensity provides density,
            LocalLayoutDirection provides LayoutDirection.Ltr,
            LocalFocusManager provides focusOwner,
            LocalViewConfiguration provides viewConfiguration,
            LocalWindowInfo provides windowInfo,
            LocalDragAndDropManager provides dragAndDropOwner,
            LocalTextToolbar provides remember { DefaultTextToolbar() },
            LocalWindow provides this,
        ) {
            InterceptPlatformTextInput(remember { PlatformTextInputInterceptor { _, _ -> suspendCancellableCoroutine { } } }) {
                cell {
                    withLayoutBuilderStack {
                        val uiRootCell = cell {
                            uiRoot(focusOwner.focusRoot) {
                                Box(Modifier.then(dragAndDropOwner.modifier), propagateMinConstraints = true) {
                                    val windowScope = remember(this@HeadlessWindow) {
                                        object : WindowScope {
                                            override val window: Window
                                                get() = this@HeadlessWindow
                                        }
                                    }
                                    contentState.value?.let { windowScope.it() }
                                }
                            }
                        }

                        val rootLayoutThunkCell = cell {
                            val rootLayoutBuilder =
                                uiRootCell.read().layoutBuilder ?: rememberEmptyLayoutBuilder()
                            density.run {
                                rootLayoutBuilder.measure(
                                    Constraints.fixed(
                                        contentSize.width.roundToPx(),
                                        contentSize.height.roundToPx(),
                                    ),
                                )
                            }
                        }

                        activeCell {
                            //                            renderPerfMetrics.startLayout(window.windowId)
                            latestRootLayoutNode = memo {
                                LayoutScope(currentNoriaContext).run {
                                    rootLayoutThunkCell.read()
                                        .realize(
                                            density.run {
                                                IntRect(
                                                    0,
                                                    0,
                                                    contentSize.width.roundToPx(),
                                                    contentSize.height.roundToPx(),
                                                )
                                            },
                                        )
                                        .apply {
                                            // todo[unterhofer] Activate this when there is time to fix the offenders
                                            // check(overlays.read().isEmpty()) {
                                            // "Overlays were emitted into a non-existent OverlayHost: ${overlays.read()}\nWrap the subtree in an OverlayHost for each key"
                                            // }
                                            node.place(IntOffset.Zero)
                                        }.node
                                }
                            }

                            // todo[unterhofer] make this synchronous again once we have the new version of
                            //  SuspendingPointerInputFilter:
                            //  https://cs.android.com/androidx/platform/frameworks/support/+/androidx-main:compose/ui/ui/src/commonMain/kotlin/androidx/compose/ui/input/pointer/SuspendingPointerInputFilter.kt;l=575
                            /**
                             * Send [PointerEventType.Enter] events to [LayoutNode]s which appeared under the
                             * cursor, so that the user doesn't have to move their mouse to trigger hovering.
                             * This has to run in a coroutine dispatched on the effect dispatcher because new
                             * [SuspendingPointerInputFilter]s will schedule their blocks there as well, and
                             * otherwise they won't be waiting for events yet.
                             */
                            rememberCoroutineScope().launch {
                                inputStateTracker.sendPointerInputEventWithCurrentStateIfNecessary(
                                    if (application.inputModeManager.inputMode == InputMode.Touch) {
                                        PointerEventType.Move
                                    } else {
                                        PointerEventType.Exit
                                    },
                                )
                            }

                            //                            renderPerfMetrics.endLayout(window.windowId)

                            onLayout(WindowData(id, uiRootCell.read(), latestRootLayoutNode!!))

                            val callbackInterceptor = CallbackInterceptorCompositionLocal.current

                            DisposableEffect(callbackInterceptor) {
                                drawContent = {
                                    span("drawing") {
                                        callbackInterceptor.execute {
                                            RenderContext(this).renderWithLayerScope(
                                                latestRootLayoutNode!!,
                                                density.run {
                                                    IntRect(
                                                        0,
                                                        0,
                                                        contentSize.width.roundToPx(),
                                                        contentSize.height.roundToPx(),
                                                    )
                                                },
                                            )
                                        }
                                    }
                                }
                                onDispose {
                                    drawContent = null
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    @OptIn(InternalCoreApi::class)
    internal fun handleEvent(event: WindowEvent) {
        when (event) {
            is Event.KeyDown, is Event.KeyUp,
            is Event.MouseDown, is Event.MouseUp, is Event.MouseMoved,
            is Event.MouseEntered, is Event.MouseExited -> {
                inputStateTracker.updateStateAndSendEvents(event, density)
            }
        }
    }

    override fun requestClose() {
        onCloseRequest()
    }
}
